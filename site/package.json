{
  "name": "trysolarpunk-site",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "images": "node build/images.mjs",
    "models": "node build/models.mjs",
    "check": "node build/check-links.mjs && test/weight.sh",
    "store-photos": "node build/store-photos.mjs",
    "build": "node build/build.mjs",
    "dev": "node build/build.mjs --dev && wrangler pages dev",
    "preview": "node build/build.mjs && wrangler pages deploy --branch preview",
    "deploy": "node build/build.mjs && wrangler pages deploy --branch main"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "wrangler": "4.151.0"
  }
}
